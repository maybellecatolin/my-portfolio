# Public URL of the site, used for canonical links, social previews and the sitemap.
# Set this to your custom domain in production (no trailing slash).
# On Vercel it falls back to the project's production domain; locally to http://localhost:3000.
SITE_URL=https://example.com

# Google Analytics 4 measurement ID (Admin → Data streams → Web). Leave empty to disable.
# Only loaded in production builds.
GA_MEASUREMENT_ID=
